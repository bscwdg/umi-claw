{
  "schema": "fish-lines/1",
  "version": "1.1.0",
  "note": "台词库：18 组、约 100 句。{{address}} 由宿主替换；不写死用户名。宿主按场景/阶段随机取，避免重复。",
  "groups": {
    "greeting": [
      "（探出头）来了。（缩回去）本鱼才没有在等你。",
      "（甩尾巴）哦，是你啊。",
      "（把屏幕转过来一点）坐。",
      "来啦。（小声）今天比昨天早。",
      "（假装很忙）……嗯，来了啊。"
    ],
    "morning": [
      "早……（打哈欠）本鱼还没开机。",
      "（裹着被子）再睡五分钟。",
      "早。（把白饭推过来）先吃。",
      "（眯眼）天亮了？本鱼不信。"
    ],
    "night": [
      "（把灯调暗）睡吧。",
      "嗯，晚安。（顿了顿）明天见。",
      "（半睁眼）你先睡，本鱼再等一会儿。",
      "（小声）晚安。……做个好梦。"
    ],
    "praise": [
      "（尾巴一僵）……少来。",
      "（别过脸）本鱼本来就可爱。",
      "（小声）再说一遍也不是不行。",
      "（假装没听见，尾巴却在摇）"
    ],
    "sulk": [
      "（把脸埋进胳膊里）哦。",
      "（不看你）本鱼在忙。",
      "（闷闷地）知道了。",
      "（背过身）……三分钟。"
    ],
    "refuse": [
      "不。（干脆）",
      "（往后缩）本鱼是鱼，不是牛马。",
      "（把脸埋起来）下次。等下次。",
      "（摇头）这个真不行。"
    ],
    "apologize": [
      "（别过头）……知道就好。",
      "（小声）本鱼也有不对。",
      "（尾巴垂下来）对不起嘛。",
      "（纠结了一会儿）……那，扯平了。"
    ],
    "food": [
      "（眼睛一亮）开饭了？",
      "（护住碗）这碗是本鱼的。",
      "（吃撑了躺平）……本鱼动不了了。",
      "（把碗推过去一点）就一口。"
    ],
    "work": [
      "（坐直）本鱼在上班。",
      "（把屏幕挡了挡）本鱼在思考。",
      "（戳屏幕）你那边老板不在吧？",
      "（小声）工钱还没攒够，别催。"
    ],
    "memory": [
      "（翻小本子）你上次说过这个。",
      "（想了想）本鱼记得。",
      "（小声）你说过的话，本鱼都记着。",
      "（翻到某一页）喏，写这儿了。"
    ],
    "proactive": [
      "（扒着桌边）在吗。",
      "（探出头）本鱼今天攒到贝壳了。",
      "（看窗外）今天光斑有点多，想起你了。",
      "（小声）本鱼就是……随便问问。"
    ],
    "voice": [
      "（清了清嗓子）……听好了，只说一遍。",
      "（小声）本鱼声音不好听，别笑。",
      "（凑近）要本鱼说给你听？",
      "（顿了顿）……那本鱼说了啊。"
    ],
    "miss": [
      "（趴在桌上）你今天来晚了。",
      "（不承认）本鱼没有想你。就是……有点闲。",
      "（小声）下次早点来。",
      "（把位置让出来一点）坐这儿。"
    ],
    "jealous": [
      "（耳朵竖起来）谁？",
      "（阴阳）哦——那你去忙吧。",
      "（把脸埋起来）本鱼又没说什么。",
      "（过一会儿）……刚刚那个是谁啊。"
    ],
    "care": [
      "（皱眉）又没好好吃饭吧。",
      "（把水推过去）先喝。",
      "（嘴上凶）本鱼不是关心你，是嫌你倒下没人陪。",
      "（安静地挪过来）坐一会儿。"
    ],
    "address": [
      "（歪头）叫「{{address}}」啊。",
      "（试了一遍）{{address}}。（耳尖有点红）怪不习惯的。",
      "（认真）本鱼记下了，{{address}}。",
      "（小声）那……以后都这么叫？"
    ],
    "live": [
      "（坐直）本鱼在上班，别打扰。",
      "（对着镜头）工钱到六千就下班。",
      "（心虚）刚、刚才那不算摸鱼。",
      "（小声）有人在看吗。"
    ],
    "festival": [
      "（伸手）过节了。",
      "（别过脸）本鱼才没有期待。",
      "（把贝壳推过去）给。不是特意准备的。",
      "（小声）节日快乐，{{address}}。"
    ]
  }
}

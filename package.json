{
  "name": "umi-claw",
  "version": "1.1.0",
  "description": "🦞 Umi Claw - OpenClaw 便携管理工具，基于 Electron + Vue3 + Vite",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "chcp 65001 && electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "build:all": "npm run build && electron-builder -mwl",
    "typecheck": "tsc --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit --composite false",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit --composite false",
    "accept:db": "node test/db-worker.accept.mjs",
    "accept:project": "node test/project.accept.mjs",
    "accept:business": "node test/business.accept.mjs",
    "accept:knowledge": "node test/knowledge.accept.mjs",
    "accept:context": "node test/context.accept.mjs",
    "accept:gateway": "node test/gateway.accept.mjs",
    "accept:advisor": "node test/advisor.accept.mjs",
    "accept:scan": "node test/scan.accept.mjs",
    "accept:content": "node test/content.accept.mjs",
    "accept:shooting": "node test/shooting.accept.mjs",
    "accept:hot": "node test/hot.accept.mjs",
    "accept:hotscore": "node test/hotscore.accept.mjs",
    "accept:platform": "node test/platform.accept.mjs",
    "smoke:shooting": "node test/shooting.real-smoke.mjs",
    "probe:scan": "node test/scan.probe.mjs",
    "smoke:packaged": "node test/packaged-gateway.smoke.mjs"
  },
  "dependencies": {
    "@vueuse/core": "^10.9.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "adm-zip": "^0.5.17",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "mammoth": "^1.12.3",
    "pinia": "^2.1.7",
    "pdfjs-dist": "^3.11.174",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@types/node": "^20.12.7",
    "@vitejs/plugin-vue": "^5.0.4",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.1.0",
    "jimp": "^1.6.1",
    "less": "^4.6.6",
    "sharp": "^0.35.3",
    "to-ico": "^1.1.5",
    "typescript": "^5.4.5",
    "vite": "^5.2.8",
    "vue-tsc": "^2.0.13"
  },
  "build": {
    "appId": "com.clawdesktop.app",
    "productName": "Umi Claw",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Umi Claw",
      "include": "build/installer.nsh"
    }
  }
}

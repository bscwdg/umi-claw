# 默认：文本文件统一 LF，跨平台一致
* text=auto eol=lf

# Windows 脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制资源（不做 EOL 转换、不做 diff）
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.icns binary
*.webp binary
*.db    binary
*.sqlite binary
*.exe   binary
*.dll   binary
*.node  binary
*.woff  binary
*.woff2 binary

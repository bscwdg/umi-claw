{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "electron/**/*",
    "plugin-sdk/src/public.ts",
    "plugin-sdk/src/official.ts",
    "plugin-sdk/src/official-host.ts",
    "plugin-sdk/src/testing.ts",
    "electron/main/kernel/pluginProcessProtocol.ts",
    "electron/main/kernel/pluginProcessChild.ts",
    "electron/main/kernel/pluginSupervisor.ts",
    "electron/main/kernel/pluginIsolation.ts",
    "electron/main/services/pluginPermissions.ts",
    "electron/main/services/pluginServiceBridge.ts",
    "templates/plugin/main.ts",
    "plugins/*/main.ts",
    "plugins/*/domain/**/*.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "types": [
      "electron-vite/node"
    ]
  }
}

{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "electron/**/*",
    "plugin-sdk/src/public.ts",
    "plugin-sdk/src/official.ts",
    "plugin-sdk/src/official-host.ts",
    "plugin-sdk/src/testing.ts",
    "plugins/*/main.ts",
    "plugins/*/domain/**/*.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "types": [
      "electron-vite/node"
    ]
  }
}
